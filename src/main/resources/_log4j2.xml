<?xml version="1.0"?>
<Configuration>
	<Appenders>
		<Console target="SYSTEM_OUT" name="Console">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} [%style{%t}{bright,blue}] %style{%C{1.}}{bright,yellow}: %msg%n%throwable" />
		</Console>
	</Appenders>
	<Loggers>
		<Root level="error">
			<AppenderRef ref="Console" />
		</Root>
		<Logger name="it.csi.cpass" level="info" />
	</Loggers>
</Configuration>